
---
import { players } from "../data/players";

const rankedPlayers = [...players].sort((a, b) => {
  const aTotal = a.wins + a.losses;
  const bTotal = b.wins + b.losses;
  const aRate = aTotal ? a.wins / aTotal : 0;
  const bRate = bTotal ? b.wins / bTotal : 0;
  return bRate - aRate || b.wins - a.wins || a.name.localeCompare(b.name);
});

const totalWins = players.reduce((sum, player) => sum + player.wins, 0);
const totalLosses = players.reduce((sum, player) => sum + player.losses, 0);
const totalGames = totalWins + totalLosses;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111211" />
    <meta name="description" content="La Liga del Lefsito — Left 4 Dead 2." />
    <title>La Liga del Lefsito</title>

    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800;900&family=DM+Mono:wght@400;500&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>

  <body>
    <div class="noise"></div>

    <main class="shell">
      <header class="topbar">
        <a class="brand" href="#" aria-label="Inicio de La Liga del Lefsito">
          <span class="brand-mark">L4D<span>2</span></span>
          <span class="brand-caption">LA ÚLTIMA RESISTENCIA<br />REGISTRO DE LA COMUNIDAD</span>
        </a>

        <div class="status">
          <span class="status-dot"></span>
          REGISTRO DE CAMPAÑA
          <span class="status-divider">/</span>
          TEMPORADA 01
        </div>
      </header>

      <section class="hero">
        <div class="hero-copy">
          <div class="eyebrow">
            <span class="eyebrow-line"></span>
            BASE DE DATOS DEL REFUGIO
            <span class="eyebrow-line"></span>
          </div>

          <h1>LA LIGA DEL<br /><em>LEFSITO</em></h1>
          <p class="hero-description">De camino a Navidad.</p>
        </div>

        <div class="hero-stamp" aria-hidden="true">
          <div class="stamp-ring">
            <span>SIN<br />PIEDAD</span>
            <b>★</b>
          </div>
          <small>DESDE 2009 · ZONA DE RIESGO</small>
        </div>
      </section>

      <section class="stats-strip" aria-label="Estadísticas generales">
        <div class="strip-item">
          <span class="strip-label">SUPERVIVIENTES</span>
          <strong>{String(players.length).padStart(2, "0")}</strong>
        </div>

        <div class="strip-item">
          <span class="strip-label">VICTORIAS TOTALES</span>
          <strong>{String(totalWins).padStart(2, "0")}</strong>
        </div>

        <div class="strip-item">
          <span class="strip-label">DERROTAS TOTALES</span>
          <strong>{String(totalLosses).padStart(2, "0")}</strong>
        </div>

        <div class="strip-item">
          <span class="strip-label">PARTIDAS JUGADAS</span>
          <strong>{String(totalGames).padStart(2, "0")}</strong>
        </div>
      </section>

      <section class="leaderboard-section">
        <div class="section-heading">
          <div>
            <div class="eyebrow small">
              <span class="red-square"></span>
              LOS SUPERVIVIENTES
            </div>
            <h2>CLASIFICACIÓN <span>DE JUGADORES</span></h2>
          </div>

          <div class="sort-note">
            <span class="sort-icon">↕</span>
            ORDENADO POR % DE VICTORIAS
          </div>
        </div>

        <div class="table-wrap">
          <div class="table-head">
            <span class="player-col">JUGADOR</span>
            <span>VICTORIAS</span>
            <span>DERROTAS</span>
            <span class="rate-col">% VICTORIAS</span>
          </div>

          <div class="player-list">
            {rankedPlayers.map((player, index) => {
              const total = player.wins + player.losses;
              const rate = total ? (player.wins / total) * 100 : 0;

              return (
                <article class="player-row">
                  <div class="player-identity">
                    <span class="rank">{String(index + 1).padStart(2, "0")}</span>

                    <div class="avatar" style={`--avatar-color:${player.color}`}>
                      <span>{player.initials}</span>
                      <i></i>
                    </div>

                    <span class="player-name">{player.name}</span>
                  </div>

                  <div class="number wins">{player.wins}</div>
                  <div class="number losses">{player.losses}</div>

                  <div class="rate-cell">
                    <strong>{rate.toFixed(1)}<small>%</small></strong>
                    <div class="rate-track">
                      <span style={`width:${rate}%`}></span>
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        </div>

        <p class="table-footnote">
          <span>*</span>
          PORCENTAJE DE VICTORIAS = VICTORIAS / (VICTORIAS + DERROTAS).
          Sin partidas jugadas = 0,0%.
        </p>
      </section>

      <footer class="footer">
        <span class="footer-mark">L4D2 <b>///</b> REGISTRO DE SUPERVIVIENTES</span>
        <span>MANTÉN CERCA A TUS AMIGOS. Y MÁS CERCA TODAVÍA LA MUNICIÓN.</span>
        <span class="footer-live"><i></i> REFUGIO ASEGURADO</span>
      </footer>
    </main>
  </body>
</html>

<style>
  :root {
    font-family: Inter, sans-serif;
    color: #e9e8e1;
    background: #111211;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: radial-gradient(ellipse at 50% -20%, #33332d 0%, #191a17 42%, #10110f 78%);
    overflow-x: hidden;
  }

  .noise {
    position: fixed;
    inset: 0;
    pointer-events: none;
    opacity: .055;
    z-index: 5;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E");
  }

  .shell {
    width: min(1080px, calc(100% - 48px));
    margin: 0 auto;
  }

  .topbar {
    height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #ffffff18;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: inherit;
    text-decoration: none;
  }

  .brand-mark {
    font: 900 29px 'Barlow Condensed', sans-serif;
    letter-spacing: -1px;
    color: #e9e8e1;
  }

  .brand-mark span {
    color: #e14c3d;
  }

  .brand-caption {
    font: 500 8px/1.4 'DM Mono', monospace;
    letter-spacing: 1.1px;
    color: #85867d;
  }

  .status, .sort-note {
    font: 10px 'DM Mono', monospace;
    letter-spacing: 1.2px;
    color: #a1a197;
  }

  .status-dot, .footer-live i {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d94b3c;
    margin-right: 8px;
    box-shadow: 0 0 10px #d94b3c88;
  }

  .status-divider {
    padding: 0 10px;
    color: #55564f;
  }

  .hero {
    min-height: 290px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 48px 6px 42px;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #c75a4b;
    font: 10px 'DM Mono', monospace;
    letter-spacing: 2.2px;
  }

  .eyebrow-line {
    height: 1px;
    width: 22px;
    background: #a8463b;
  }

  h1 {
    font: 900 clamp(56px, 8vw, 88px)/.83 'Barlow Condensed', sans-serif;
    letter-spacing: -2px;
    margin: 22px 0 17px;
    color: #f0efe8;
  }

  h1 em {
    font-style: normal;
    color: #d94e40;
  }

  .hero-description {
    font-size: 12px;
    color: #898a80;
    letter-spacing: .15px;
  }

  .hero-stamp {
    margin-right: 34px;
    text-align: center;
    transform: rotate(-10deg);
    opacity: .78;
  }

  .stamp-ring {
    width: 112px;
    height: 112px;
    border: 2px solid #a7493e;
    border-radius: 50%;
    outline: 1px dashed #a7493e;
    outline-offset: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    color: #bd5145;
  }

  .stamp-ring:before, .stamp-ring:after {
    content: "";
    position: absolute;
    width: 125%;
    height: 1px;
    background: #a7493e;
    opacity: .7;
    transform: rotate(45deg);
  }

  .stamp-ring:after {
    transform: rotate(-45deg);
  }

  .stamp-ring span {
    font: 900 22px/.82 'Barlow Condensed', sans-serif;
    z-index: 1;
  }

  .stamp-ring b {
    position: absolute;
    bottom: 12px;
    right: 14px;
    font-size: 12px;
  }

  .hero-stamp small {
    display: block;
    margin-top: 14px;
    font: 8px 'DM Mono', monospace;
    letter-spacing: 1px;
    color: #b95b4e;
  }

  .stats-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: 1px solid #ffffff1b;
    background: #ffffff06;
    margin-bottom: 55px;
  }

  .strip-item {
    padding: 15px 20px;
    border-right: 1px solid #ffffff18;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .strip-item:last-child {
    border: 0;
  }

  .strip-label {
    font: 9px 'DM Mono', monospace;
    letter-spacing: 1px;
    color: #85867d;
  }

  .strip-item strong {
    font: 700 23px 'Barlow Condensed', sans-serif;
    color: #e7e5dc;
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    margin-bottom: 17px;
  }

  .eyebrow.small {
    font-size: 9px;
    letter-spacing: 1.8px;
    gap: 8px;
  }

  .red-square {
    width: 6px;
    height: 6px;
    background: #d94e40;
    display: inline-block;
  }

  h2 {
    font: 800 31px 'Barlow Condensed', sans-serif;
    letter-spacing: .6px;
    margin: 7px 0 0;
  }

  h2 span {
    color: #d94e40;
  }

  .sort-note {
    padding-bottom: 4px;
    font-size: 9px;
  }

  .sort-icon {
    color: #d94e40;
    font-size: 14px;
    margin-right: 6px;
  }

  .table-wrap {
    border: 1px solid #ffffff20;
    background: #171815;
  }

  .table-head, .player-row {
    display: grid;
    grid-template-columns: minmax(260px, 1fr) 120px 120px 180px;
    align-items: center;
  }

  .table-head {
    min-height: 43px;
    background: #22231f;
    border-bottom: 1px solid #ffffff20;
    color: #85867d;
    font: 9px 'DM Mono', monospace;
    letter-spacing: 1.2px;
    padding: 0 22px;
  }

  .table-head>span:not(:first-child) {
    text-align: center;
  }

  .table-head .rate-col {
    text-align: right;
  }

  .player-row {
    min-height: 72px;
    padding: 0 22px;
    border-bottom: 1px solid #ffffff10;
    transition: background .2s;
  }

  .player-row:last-child {
    border-bottom: 0;
  }

  .player-row:hover {
    background: #ffffff08;
  }

  .player-identity {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .rank {
    font: 10px 'DM Mono', monospace;
    color: #62645c;
    width: 34px;
  }

  .avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--avatar-color), transparent 25%);
    background: radial-gradient(circle at 35% 25%, color-mix(in srgb, var(--avatar-color), white 15%), var(--avatar-color) 75%, #222 130%);
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
    box-shadow: inset 0 0 0 3px #10110f, 0 0 0 1px #ffffff12;
  }

  .avatar:after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(140deg, #ffffff35, transparent 48%, #0005);
  }

  .avatar span {
    z-index: 1;
    font: 800 12px 'Barlow Condensed', sans-serif;
    color: #171713;
    text-shadow: 0 1px #ffffff55;
  }

  .avatar i {
    position: absolute;
    bottom: -5px;
    width: 25px;
    height: 13px;
    border-radius: 50% 50% 0 0;
    background: #141510;
    z-index: 1;
  }

  .player-name {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: .2px;
    margin-left: 13px;
    color: #e7e6de;
  }

  .number {
    text-align: center;
    font: 500 15px 'DM Mono', monospace;
  }

  .wins { color: #a9c18c; }
  .losses { color: #d27b6d; }

  .rate-cell {
    display: flex;
    align-items: flex-end;
    flex-direction: column;
    gap: 7px;
  }

  .rate-cell strong {
    font: 700 16px 'DM Mono', monospace;
    color: #e9e8e1;
  }

  .rate-cell small {
    font-size: 10px;
    color: #85867d;
    margin-left: 2px;
  }

  .rate-track {
    height: 3px;
    width: 76px;
    background: #393a34;
    overflow: hidden;
  }

  .rate-track span {
    height: 100%;
    display: block;
    background: #d94e40;
  }

  .table-footnote {
    font: 9px 'DM Mono', monospace;
    color: #73756c;
    margin: 12px 0 0;
    letter-spacing: .1px;
  }

  .table-footnote span {
    color: #d94e40;
  }

  .footer {
    margin: 66px 0 25px;
    padding: 17px 0;
    border-top: 1px solid #ffffff1a;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 14px;
    color: #6f7168;
    font: 8px 'DM Mono', monospace;
    letter-spacing: .7px;
  }

  .footer-mark { color: #aaa99f; }
  .footer-mark b { color: #d94e40; }

  .footer-live { color: #8d9c79; }

  .footer-live i {
    width: 5px;
    height: 5px;
    background: #8d9c79;
    box-shadow: 0 0 8px #8d9c7988;
  }

  @media(max-width:700px) {
    .shell {
      width: min(100% - 30px, 560px);
    }

    .topbar { height: 68px; }
    .status { font-size: 8px; letter-spacing: .5px; }

    .hero {
      min-height: 240px;
      padding: 38px 2px;
    }

    .hero-stamp {
      margin-right: 10px;
      transform: scale(.78) rotate(-10deg);
    }

    h1 { font-size: clamp(54px, 12vw, 76px); }

    .stats-strip {
      grid-template-columns: repeat(2, 1fr);
      margin-bottom: 42px;
    }

    .strip-item { padding: 12px 14px; }
    .strip-item:nth-child(2) { border-right: 0; }

    .strip-item:nth-child(-n+2) {
      border-bottom: 1px solid #ffffff18;
    }

    .table-head, .player-row {
      grid-template-columns: minmax(0, 1fr) 58px 58px 90px;
      padding-left: 12px;
      padding-right: 12px;
    }

    .table-head {
      font-size: 8px;
      letter-spacing: .5px;
    }

    .player-row { min-height: 66px; }

    .rank { width: 25px; font-size: 9px; }
    .avatar { width: 33px; height: 33px; }
    .player-name { font-size: 12px; margin-left: 9px; }
    .number { font-size: 12px; }
    .rate-cell strong { font-size: 12px; }
    .rate-track { width: 55px; }

    .footer {
      flex-wrap: wrap;
      line-height: 1.6;
    }

    .footer>span:nth-child(2) {
      order: 3;
      width: 100%;
    }
  }

  @media(max-width:390px) {
    .hero-stamp { display: none; }

    .table-head, .player-row {
      grid-template-columns: minmax(0, 1fr) 48px 52px 78px;
    }

    .table-head {
      padding-left: 8px;
      padding-right: 8px;
    }

    .player-row {
      padding-left: 8px;
      padding-right: 8px;
    }

    .rank { width: 21px; }
    .player-name { font-size: 11px; }
    .avatar { width: 30px; height: 30px; }
  }
</style>
